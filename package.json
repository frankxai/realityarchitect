{
  "name": "realityarchitect",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Reality Architect — the open method for going from AI tool-user to system-builder. This repo is the website and the method.",
  "homepage": "https://www.realityarchitect.ai",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "test:governance": "node --test scripts/tests/governance-gates.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "claims:check": "node scripts/check-public-claims.mjs",
    "plugin:data": "node scripts/build-plugin-data.mjs",
    "test": "node --test",
    "gate": "pnpm lint && pnpm claims:check && pnpm test && pnpm build && node scripts/check-built-pages.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
