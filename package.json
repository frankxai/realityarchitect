{
  "name": "realityarchitect",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Reality Architect \u2014 the open method for going from AI tool-user to system-builder. This repo is the website and the method.",
  "homepage": "https://www.realityarchitect.ai",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "test:governance": "node --test scripts/tests/governance-gates.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "claims:check": "node scripts/check-public-claims.mjs",
    "plugin:data": "node scripts/build-plugin-data.mjs",
    "test": "node --test",
    "gate": "pnpm lint && pnpm claims:check && pnpm test && pnpm build",
    "build:eve": "eve build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@vercel/functions": "3.9.9",
    "ai": "7.0.127",
    "eve": "0.69.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.5",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
